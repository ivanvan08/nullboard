# Copy this file to .env and fill in real values. .env is ignored by git.
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-generated-key

# True enables Django debug pages and serves static files in development.
DEBUG=True

# Comma-separated hosts the server accepts requests for.
ALLOWED_HOSTS=127.0.0.1,localhost

# The project uses SQLite, so there is no database password to configure.
# To switch to PostgreSQL, replace DATABASES in config/settings.py with values
# read from DB_NAME, DB_USER, DB_PASSWORD, DB_HOST and DB_PORT, and add them here.
DB_NAME=db.sqlite3
